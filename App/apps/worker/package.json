{
  "name": "@oriva/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var APP_ENV:local --var OTP_DEV_MODE:true",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply oriva-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply oriva-db --remote",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@oriva/shared": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  }
}
