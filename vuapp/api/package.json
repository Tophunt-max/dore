{
  "name": "@vuapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute vuapp-db --local --file=./src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute vuapp-db --local --file=./src/db/seed.sql",
    "db:init:remote": "wrangler d1 execute vuapp-db --remote --file=./src/db/schema.sql",
    "db:seed:remote": "wrangler d1 execute vuapp-db --remote --file=./src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
