{
  "name": "vuapp-platform",
  "version": "0.1.0",
  "private": true,
  "description": "vuapp — uni-app (Vue 3) hybrid app, Cloudflare Worker API, and admin panel. Independent project.",
  "workspaces": [
    "api",
    "app",
    "admin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w @vuapp/api",
    "dev:app": "npm run dev:h5 -w @vuapp/app",
    "dev:admin": "npm run dev -w @vuapp/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
